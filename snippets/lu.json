{
  "Условный оператор если": {
    "prefix": "если",
    "body": [
      "если ${1:условие} то",
      "\t$0",
      "конец"
    ],
    "description": "Условный оператор"
  },
  "Условный оператор если/иначе": {
    "prefix": "если-иначе",
    "body": [
      "если ${1:условие} то",
      "\t$0",
      "иначе",
      "\t${2:...}",
      "конец"
    ],
    "description": "Условный оператор с веткой иначе"
  },
  "Цикл для": {
    "prefix": "для",
    "body": [
      "для ${1:i} от ${2:1} до ${3:10}",
      "\t$0",
      "конец"
    ],
    "description": "Цикл со счётчиком"
  },
  "Цикл пока": {
    "prefix": "пока",
    "body": [
      "пока ${1:условие}",
      "\t$0",
      "конец"
    ],
    "description": "Цикл с условием"
  },
  "Цикл повтори": {
    "prefix": "повтори",
    "body": [
      "повтори ${1:3} раз",
      "\t$0",
      "конец"
    ],
    "description": "Цикл повторений"
  },
  "Процедура": {
    "prefix": "процедура",
    "body": [
      "процедура ${1:имя}(${2:параметры})",
      "\t$0",
      "конец"
    ],
    "description": "Определение процедуры"
  },
  "Процедура без параметров": {
    "prefix": "процедура-без-параметров",
    "body": [
      "процедура ${1:имя}()",
      "\t$0",
      "конец"
    ],
    "description": "Определение процедуры без параметров"
  },
  "Вывод": {
    "prefix": "печать",
    "body": "печать(${1:выражение})",
    "description": "Вывод значения на экран"
  },
  "Присваивание": {
    "prefix": "запомнить",
    "body": "запомнить ${1:имя} = ${2:значение}",
    "description": "Объявление переменной"
  },
  "Возврат значения": {
    "prefix": "вернуть",
    "body": "вернуть ${1:значение}",
    "description": "Возврат значения из процедуры"
  },
  "Вызов процедуры": {
    "prefix": "выполнить",
    "body": "выполнить ${1:процедура}(${2:аргументы})",
    "description": "Вызов процедуры"
  },
  "Код символа": {
    "prefix": "код",
    "body": "код(${1:символ})",
    "description": "Unicode-код символа"
  },
  "Символ по коду": {
    "prefix": "символ",
    "body": "символ(${1:число})",
    "description": "Символ по Unicode-коду"
  },
  "Поиск в строке": {
    "prefix": "найти",
    "body": "найти(${1:строка}, ${2:подстрока})",
    "description": "Поиск подстроки"
  },
  "Подстрока": {
    "prefix": "подстрока",
    "body": "подстрока(${1:строка}, ${2:начало}, ${3:длина})",
    "description": "Вырезать подстроку"
  },
  "Добавить в массив": {
    "prefix": "добавить",
    "body": "добавить(${1:массив}, ${2:значение})",
    "description": "Добавить элемент в массив"
  },
  "Удалить из массива": {
    "prefix": "удалить",
    "body": "удалить(${1:массив}, ${2:индекс})",
    "description": "Удалить элемент из массива"
  },
  "Квадратный корень": {
    "prefix": "корень",
    "body": "корень(${1:число})",
    "description": "Квадратный корень"
  },
  "Модуль числа": {
    "prefix": "модуль",
    "body": "модуль(${1:число})",
    "description": "Модуль (абсолютное значение)"
  },
  "Случайное число": {
    "prefix": "случ",
    "body": "случ(${1:до})",
    "description": "Случайное число от 0 до N-1"
  },
  "Округление": {
    "prefix": "округлить",
    "body": "округлить(${1:число})",
    "description": "Округление до целого"
  },
  "Верхний регистр": {
    "prefix": "вверх",
    "body": "вверх(${1:строка})",
    "description": "Преобразование в верхний регистр"
  },
  "Нижний регистр": {
    "prefix": "вниз",
    "body": "вниз(${1:строка})",
    "description": "Преобразование в нижний регистр"
  },
  "Замена подстроки": {
    "prefix": "заменить",
    "body": "заменить(${1:строка}, ${2:что}, ${3:на_что})",
    "description": "Замена подстроки"
  },
  "Разбить строку": {
    "prefix": "разделить",
    "body": "разделить(${1:строка}, ${2:разделитель})",
    "description": "Разбить строку в массив по разделителю"
  },
  "Склеить массив": {
    "prefix": "соединить",
    "body": "соединить(${1:массив}, ${2:разделитель})",
    "description": "Склеить массив в строку через разделитель"
  },
  "Проверка префикса": {
    "prefix": "начинается",
    "body": "начинается(${1:строка}, ${2:префикс})",
    "description": "Проверка, начинается ли строка с префикса"
  },
  "Проверка суффикса": {
    "prefix": "заканчивается",
    "body": "заканчивается(${1:строка}, ${2:суффикс})",
    "description": "Проверка, заканчивается ли строка суффиксом"
  },
  "Переворот строки": {
    "prefix": "перевернуть",
    "body": "перевернуть(${1:строка})",
    "description": "Разворот строки"
  },
  "Прерывание цикла": {
    "prefix": "прервать",
    "body": "прервать",
    "description": "Досрочный выход из цикла"
  },
  "Продолжить цикл": {
    "prefix": "продолжить",
    "body": "продолжить",
    "description": "Переход к следующей итерации цикла"
  }
}